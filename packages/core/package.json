{
  "name": "@britecharts/core",
  "version": "3.0.0-beta.4",
  "main": "dist/umd/bundle/core.bundled.min.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "dependencies": {
    "@types/base-64": "1.0.2",
    "@types/d3-array": "3.2.2",
    "@types/d3-axis": "3.0.6",
    "@types/d3-brush": "3.0.6",
    "@types/d3-color": "3.1.3",
    "@types/d3-delaunay": "6.0.4",
    "@types/d3-dispatch": "3.0.7",
    "@types/d3-ease": "3.0.2",
    "@types/d3-format": "3.0.4",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "catalog:",
    "@types/d3-shape": "3.2.0",
    "@types/d3-time": "3.0.4",
    "@types/d3-time-format": "4.0.3",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "base-64": "0.1.0",
    "d3-array": "3.2.4",
    "d3-axis": "3.0.0",
    "d3-brush": "3.0.0",
    "d3-color": "3.1.0",
    "d3-delaunay": "6.0.4",
    "d3-dispatch": "3.0.1",
    "d3-ease": "3.0.1",
    "d3-format": "3.1.2",
    "d3-interpolate": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-selection": "catalog:",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "d3-time-format": "4.1.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-essentials": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/html-webpack5": "catalog:",
    "@storybook/manager-api": "catalog:",
    "@storybook/theming": "catalog:",
    "@types/jest": "catalog:",
    "babel-loader": "catalog:",
    "babel-plugin-istanbul": "6.1.1",
    "chromatic": "catalog:",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "d3": "5.16.0",
    "es-check": "9.8.1",
    "eslint": "catalog:",
    "extract-loader": "5.1.0",
    "file-loader": "6.2.0",
    "jest": "catalog:",
    "node-gyp": "8.4.1",
    "postcss": "catalog:",
    "raw-loader": "catalog:",
    "rimraf": "catalog:",
    "sass": "catalog:",
    "sass-loader": "catalog:",
    "storybook": "catalog:",
    "style-loader": "4.0.0",
    "stylelint": "catalog:",
    "stylelint-config-sass-guidelines": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-scss": "4.7.0",
    "underscore": "1.9.1",
    "webpack": "catalog:",
    "webpack-cli": "catalog:",
    "webpack-merge": "catalog:",
    "webpack-remove-empty-scripts": "1.1.1"
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "stylelint": {
    "plugins": [
      "stylelint-scss"
    ],
    "extends": [
      "stylelint-config-sass-guidelines",
      "stylelint-config-standard-scss"
    ],
    "rules": {
      "indentation": 4,
      "scss/dollar-variable-colon-space-after": "always",
      "no-descending-specificity": null,
      "selector-class-pattern": null,
      "max-nesting-depth": 2
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:esm && webpack --env=production && pnpm run build:check",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "babel src --out-dir dist/esm --extensions .ts,.js --no-babelrc --presets @babel/preset-typescript --ignore \"src/**/*.d.ts,src/**/*.spec.ts,src/**/*.spec.js,src/**/*.stories.js,src/**/*.stories.ts,src/**/*DataBuilder.js,src/**/*Data.js,src/**/*.fixtures.js,src/**/*.fixtures.ts\"",
    "build:bundle": "webpack --env=prodBundleConfig",
    "build:cdn:bundle": "webpack --env=CDNBundleConfig",
    "build:cdn:charts": "webpack --env=CDNChartsBundleConfig",
    "build:chartStyles": "webpack --env=prodChartStyles",
    "build:charts": "webpack --env=prodChartsConfig",
    "build:check": "es-check es2020 \"./dist/umd/bundle/core.bundled.min.js\" \"./dist/umd/charts/bar.min.js\"",
    "build:styles": "webpack --env=prodStyles",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_CORE",
    "clean": "rimraf dist",
    "demo": "pnpm run storybook",
    "demo:build": "storybook build -c .storybook -o dist/storybook",
    "lint": "pnpm run lint:js && pnpm run lint:styles",
    "lint:js": "eslint src/charts/ webpack.*.js --ext .js,.ts,.tsx --cache",
    "lint:styles": "stylelint './src/styles/**/*.scss'",
    "start": "pnpm run demo",
    "storybook": "storybook dev -p 2001 --exact-port",
    "test": "jest --colors --coverage",
    "test:watch": "jest --watch --colors",
    "check:api-parity": "node ./scripts/check-api-parity.mjs",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "CHANGELOG.md",
    "dist/esm/**",
    "dist/umd/**",
    "dist/cdn/**",
    "dist/styles/**",
    "dist/types/**",
    "src/**",
    "!**/*.map",
    "!**/*.spec.js",
    "!**/*.spec.ts",
    "!**/*.stories.js",
    "!**/*.stories.ts",
    "!**/*.stories.mdx",
    "!**/*DataBuilder.js",
    "!**/*DataBuilder.ts",
    "!**/*.fixtures.js",
    "!**/*.fixtures.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/bundle/core.bundled.min.js",
      "default": "./dist/umd/bundle/core.bundled.min.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
