{
  "name": "@britecharts/core",
  "version": "3.0.0-beta.0",
  "main": "dist/umd/bundle/core.bundled.min.js",
  "module": "src/index.js",
  "types": "src/typings/index.d.ts",
  "dependencies": {
    "base-64": "^0.1.0",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-brush": "^3.0.0",
    "d3-color": "^3.1.0",
    "d3-delaunay": "^6.0.4",
    "d3-dispatch": "^3.0.1",
    "d3-ease": "^3.0.1",
    "d3-format": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^6.5.9",
    "@storybook/addon-actions": "^6.5.9",
    "@storybook/addon-console": "^1.2.3",
    "@storybook/addon-docs": "^6.5.9",
    "@storybook/addon-viewport": "^6.5.9",
    "@storybook/html": "^6.5.9",
    "@types/d3-selection": "^1.4.1",
    "@typescript-eslint/parser": "^4.6.1",
    "babel-plugin-istanbul": "^6.0.0",
    "chromatic": "^6.15.0",
    "css-loader": "3.0.0",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "d3": "^5.16.0",
    "es-check": "^6.0.0",
    "eslint": "7.32.0",
    "eslint-loader": "^2.1.2",
    "extract-loader": "^5.1.0",
    "file-loader": "^6.2.0",
    "istanbul-instrumenter-loader": "3.0.1",
    "jest": "^29.3.1",
    "node-gyp": "8.4.1",
    "rimraf": "^2.6.3",
    "sass": "^1.104.0",
    "sass-loader": "^10.5.2",
    "style-loader": "0.23.1",
    "stylelint": "^14.15.0",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-scss": "^4.3.0",
    "typescript": "^3.9.2",
    "underscore": "1.9.1",
    "webpack": "4.46.0",
    "webpack-bundle-analyzer": "3.3.2",
    "webpack-cli": "^3.3.5",
    "webpack-dev-server": "3.7.2",
    "webpack-fix-style-only-entries": "^0.6.1",
    "webpack-merge": "4.2.1"
  },
  "browserslist": "> 0.25%, not dead",
  "babel": {
    "presets": [
      [
        "@babel/preset-env"
      ]
    ],
    "plugins": [
      [
        "@babel/plugin-transform-runtime",
        {
          "regenerator": false
        }
      ]
    ]
  },
  "stylelint": {
    "plugins": [
      "stylelint-scss"
    ],
    "extends": [
      "stylelint-config-sass-guidelines",
      "stylelint-config-standard-scss"
    ],
    "rules": {
      "indentation": 4,
      "scss/dollar-variable-colon-space-after": "always",
      "no-descending-specificity": null,
      "selector-class-pattern": null,
      "scss/at-import-no-partial-leading-underscore": null,
      "scss/no-global-function-names": null,
      "max-nesting-depth": 2,
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "function",
            "if",
            "each",
            "include",
            "mixin"
          ]
        }
      ]
    }
  },
  "scripts": {
    "build:bundle": "webpack --env=prodBundleConfig",
    "build:cdn:bundle": "webpack --env=CDNBundleConfig",
    "build:cdn:charts": "webpack --env=CDNChartsBundleConfig",
    "build:charts": "webpack --env=prodChartsConfig",
    "build:chartStyles": "webpack --env=prodChartStyles",
    "build:check": "es-check es5 \"./dist/bundled/britecharts.min.js\" \"./dist/umd/bar.min.js\"",
    "build:styles": "webpack --env=prodStyles",
    "build": "webpack --env=production",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_CORE",
    "clean": "rimraf dist",
    "demo:build": "build-storybook -c .storybook -o dist/storybook",
    "demo": "yarn run storybook",
    "lint:js": "eslint src/charts/ webpack.*.js --cache",
    "lint:styles": "stylelint './src/styles/**/*.scss'",
    "lint": "yarn run lint:js && yarn run lint:styles",
    "prebuild": "yarn run clean",
    "start": "yarn run demo",
    "storybook": "start-storybook -p 2001",
    "test:watch": "jest --watch --colors",
    "test": "jest --colors --coverage"
  },
  "files": [
    "dist/umd",
    "dist/cdn",
    "dist/styles",
    "src",
    "!**/*.map",
    "!src/**/*.spec.js",
    "!src/**/*.stories.js",
    "!src/**/*.stories.mdx",
    "!src/**/*DataBuilder.js",
    "!src/**/*.fixtures.js"
  ]
}
