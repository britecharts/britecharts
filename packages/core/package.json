{
  "name": "@britecharts/core",
  "version": "3.0.0-beta.7",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/umd/bundle/core.bundled.min.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "dependencies": {
    "@types/base-64": "1.0.2",
    "@types/d3-array": "3.2.2",
    "@types/d3-axis": "3.0.6",
    "@types/d3-brush": "3.0.6",
    "@types/d3-color": "3.1.3",
    "@types/d3-delaunay": "6.0.4",
    "@types/d3-dispatch": "3.0.7",
    "@types/d3-ease": "3.0.2",
    "@types/d3-format": "3.0.4",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "catalog:",
    "@types/d3-shape": "3.2.0",
    "@types/d3-time": "3.0.4",
    "@types/d3-time-format": "4.0.3",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "base-64": "1.0.0",
    "d3-array": "3.2.4",
    "d3-axis": "3.0.0",
    "d3-brush": "3.0.0",
    "d3-color": "3.1.0",
    "d3-delaunay": "6.0.4",
    "d3-dispatch": "3.0.1",
    "d3-ease": "3.0.1",
    "d3-format": "3.1.2",
    "d3-interpolate": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-selection": "catalog:",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "d3-time-format": "4.1.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/html-vite": "catalog:",
    "chromatic": "catalog:",
    "d3": "7.9.0",
    "es-check": "9.8.1",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "rimraf": "catalog:",
    "sass": "catalog:",
    "storybook": "catalog:",
    "stylelint": "catalog:",
    "underscore": "1.13.8",
    "vite": "catalog:"
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:esm && pnpm run build:types:cjs && pnpm run build:bundles && pnpm run build:check",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "babel src --out-dir dist/esm --extensions .ts,.js --config-file ./babel.config.esm.cjs --ignore \"src/**/*.d.ts,src/**/*.spec.ts,src/**/*.spec.js,src/**/*.stories.js,src/**/*.stories.ts,src/**/*DataBuilder.js,src/**/*Data.js,src/**/*.fixtures.js,src/**/*.fixtures.ts\"",
    "build:types:cjs": "node -e \"const fs=require('node:fs');fs.cpSync('dist/types','dist/types-cjs',{recursive:true,filter:(p)=>fs.statSync(p).isDirectory()||p.endsWith('.d.ts')});fs.writeFileSync('dist/types-cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "build:bundles": "vite build && vite build --mode cdn && vite build --mode styles && vite build --mode styles-min",
    "build:check": "es-check es2020 \"./dist/umd/bundle/core.bundled.min.cjs\" \"./dist/cdn/bundle/core.cdn.min.js\"",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_CORE --build-script-name=demo:build",
    "clean": "rimraf dist",
    "demo": "pnpm run storybook",
    "demo:build": "storybook build -c .storybook -o dist/storybook",
    "lint": "pnpm run lint:js && pnpm run lint:styles",
    "lint:js": "eslint src/charts/ vite.config.js --cache",
    "lint:styles": "stylelint './src/styles/**/*.scss'",
    "start": "pnpm run demo",
    "storybook": "storybook dev -p 2001 --exact-port",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:api-parity": "node ./scripts/check-api-parity.mjs",
    "copy:skill": "node ./scripts/copy-skill.mjs",
    "copy:license": "node ../../scripts/copy-license.mjs",
    "prepack": "pnpm run copy:skill && pnpm run copy:license",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "CHANGELOG.md",
    "dist/esm/**",
    "dist/umd/**",
    "dist/cdn/**",
    "dist/styles/**",
    "dist/types/**",
    "dist/types-cjs/**",
    "src/**",
    "skills/**",
    "!**/*.map",
    "!**/*.spec.js",
    "!**/*.spec.ts",
    "!**/*.stories.js",
    "!**/*.stories.ts",
    "!**/*.stories.mdx",
    "!**/*DataBuilder.js",
    "!**/*DataBuilder.ts",
    "!**/*.fixtures.js",
    "!**/*.fixtures.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/umd/bundle/core.bundled.min.cjs"
      },
      "default": "./dist/umd/bundle/core.bundled.min.cjs"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
