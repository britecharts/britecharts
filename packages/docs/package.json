{
  "name": "@britecharts/docs",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "docusaurus-lunr-search": "^3.6.0",
    "glob": "^7.2.0",
    "jsdoc": "^4.0.5",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^18.3.0",
    "jsdoc-to-markdown": "^9.1.3",
    "linkinator": "^8.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "build": "yarn run docs:readme && yarn run docs:api && docusaurus build",
    "clean": "yarn run clear",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "docs:api": "node ./scripts/generate-docs.js",
    "docs:links": "node ./scripts/check-links.mjs",
    "docs:readme": "node ./scripts/copy-readme.js",
    "docusaurus": "docusaurus",
    "prebuild": "yarn run clean",
    "serve": "docusaurus serve",
    "start": "yarn run docs:readme && yarn run docs:api && docusaurus start",
    "swizzle": "docusaurus swizzle",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  }
}
