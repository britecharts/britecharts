{
  "name": "@britecharts/docs",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "docusaurus-lunr-search": "3.6.0",
    "glob": "13.0.6",
    "jsdoc": "4.0.5",
    "prism-react-renderer": "2.4.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.3.0",
    "catharsis": "0.11.0",
    "jsdoc-to-markdown": "9.1.3",
    "linkinator": "8.1.0",
    "lunr": "2.3.9",
    "shadcn": "4.21.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "build": "pnpm run docs:readme && pnpm run docs:api && pnpm run docs:llms && pnpm run docs:schemas && pnpm run docs:registry && pnpm run docs:examples && docusaurus build",
    "clean": "pnpm run clear",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "docs:api": "node ./scripts/generate-docs.js",
    "docs:llms": "node ./scripts/generate-llms.mjs",
    "docs:source-links": "node ./scripts/check-source-links.mjs",
    "docs:links": "node ./scripts/check-links.mjs",
    "docs:readme": "node ./scripts/copy-readme.js",
    "docs:schemas": "node ./scripts/copy-schemas.mjs",
    "docs:registry": "shadcn build --output static/r",
    "docs:examples": "node ./scripts/copy-examples.mjs",
    "docusaurus": "docusaurus",
    "prebuild": "pnpm run clean",
    "serve": "docusaurus serve",
    "start": "pnpm run docs:readme && pnpm run docs:api && pnpm run docs:llms && pnpm run docs:schemas && pnpm run docs:registry && pnpm run docs:examples && docusaurus start",
    "swizzle": "docusaurus swizzle",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  }
}
