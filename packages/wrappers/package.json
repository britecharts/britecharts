{
  "name": "@britecharts/wrappers",
  "version": "3.0.0-beta.4",
  "main": "dist/umd/bundle/wrappers.bundled.min.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "dependencies": {
    "@britecharts/core": "workspace:^",
    "@types/d3-selection": "catalog:",
    "d3-selection": "catalog:"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/core": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@types/jest": "catalog:",
    "babel-loader": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "rimraf": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:",
    "webpack-merge": "catalog:"
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && webpack --env=production",
    "build:bundle": "webpack --env=prodBundleConfig",
    "build:esm": "pnpm run build:esm:js && pnpm run build:esm:types",
    "build:esm:js": "babel src --out-dir dist/esm --extensions .ts,.js --no-babelrc --presets @babel/preset-typescript --ignore \"src/**/*.spec.ts,src/**/*.spec.js,src/**/*.fixtures.ts,src/**/*.fixtures.js\"",
    "build:esm:types": "tsc -p tsconfig.build.json",
    "build:bundle:cjs": "webpack --env=prodCJSBundleConfig",
    "build:charts": "webpack --env=prodChartsConfig",
    "clean": "rimraf dist",
    "lint": "pnpm run lint:js",
    "lint:js": "eslint src/charts/ src/helpers webpack.*.js --ext .js,.ts,.tsx --cache",
    "test": "jest --colors --coverage",
    "test:watch": "jest --watch --colors",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "CHANGELOG.md",
    "dist/**",
    "src/**",
    "!**/*.map",
    "!**/*.spec.js",
    "!**/*.spec.ts",
    "!**/*.stories.js",
    "!**/*.stories.ts",
    "!**/*.stories.tsx",
    "!**/*.stories.mdx",
    "!**/*DataBuilder.js",
    "!**/*DataBuilder.ts",
    "!**/*.fixtures.js",
    "!**/*.fixtures.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/bundle/wrappers.bundled.min.js",
      "default": "./dist/umd/bundle/wrappers.bundled.min.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
