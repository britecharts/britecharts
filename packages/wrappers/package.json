{
  "name": "@britecharts/wrappers",
  "description": "Framework-agnostic wrappers for Britecharts: create, update and destroy any chart from a configuration that a JSON Schema checks.",
  "version": "3.0.0-beta.9",
  "license": "Apache-2.0",
  "homepage": "https://britecharts.github.io/britecharts/docs/packages/wrappers-readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/britecharts/britecharts.git",
    "directory": "packages/wrappers"
  },
  "bugs": {
    "url": "https://github.com/britecharts/britecharts/issues"
  },
  "keywords": [
    "britecharts",
    "d3",
    "charts",
    "charting-library",
    "data-visualization",
    "visualization",
    "typescript",
    "framework-agnostic",
    "json-schema",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/umd/bundle/wrappers.bundled.min.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "dependencies": {
    "@britecharts/core": "workspace:^",
    "@types/d3-selection": "catalog:",
    "d3-selection": "catalog:"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/core": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "vite": "catalog:"
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:types:cjs && pnpm run build:bundles",
    "copy:license": "node ../../scripts/copy-license.mjs",
    "prepack": "pnpm run copy:license",
    "build:types:cjs": "node -e \"const fs=require('node:fs');fs.cpSync('dist/esm','dist/types-cjs',{recursive:true,filter:(p)=>fs.statSync(p).isDirectory()||p.endsWith('.d.ts')});fs.writeFileSync('dist/types-cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "build:bundles": "vite build",
    "build:esm": "pnpm run build:esm:js && pnpm run build:esm:types",
    "build:esm:js": "babel src --out-dir dist/esm --extensions .ts,.js --config-file ./babel.config.esm.cjs --ignore \"src/**/*.spec.ts,src/**/*.spec.js,src/**/*.fixtures.ts,src/**/*.fixtures.js\"",
    "build:esm:types": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "schemas": "node scripts/generate-schemas.mjs",
    "lint": "pnpm run lint:js",
    "lint:js": "eslint src/charts/ src/helpers vite.config.js --cache",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "CHANGELOG.md",
    "dist/**",
    "schemas/**",
    "src/**",
    "!**/*.map",
    "!**/*.spec.js",
    "!**/*.spec.ts",
    "!**/*.stories.js",
    "!**/*.stories.ts",
    "!**/*.stories.tsx",
    "!**/*.stories.mdx",
    "!**/*DataBuilder.js",
    "!**/*DataBuilder.ts",
    "!**/*.fixtures.js",
    "!**/*.fixtures.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/umd/bundle/wrappers.bundled.min.cjs"
      },
      "default": "./dist/umd/bundle/wrappers.bundled.min.cjs"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  }
}
