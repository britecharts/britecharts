{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // Resolve the sibling workspace to its source, as react's tsconfig
        // does and as the alias in vitest.config.js already does for the specs.
        //
        // Core's `types` point at generated declarations in its `dist/`.
        // Without this, type-checking this package would first require building
        // that one, and would otherwise report on whatever output happened to be
        // lying around: green locally off a stale build, red in CI, which builds
        // nothing before the type-check step.
        //
        // The entry is the same source file those declarations are generated
        // from. The published ones are checked in `packages/integration`,
        // against the packed tarballs.
        "paths": {
            "@britecharts/core": ["../core/src/index.ts"]
        }
    },
    "include": ["src"]
}
