{
  "name": "@britecharts/react",
  "version": "3.0.0-beta.8",
  "license": "Apache-2.0",
  "keywords": [
    "britecharts",
    "react",
    "react-charts",
    "react-component",
    "d3",
    "charts",
    "charting-library",
    "data-visualization",
    "visualization",
    "typescript",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/umd/bundle/react.bundled.min.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "dependencies": {
    "@britecharts/core": "workspace:^",
    "@britecharts/wrappers": "workspace:^"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/core": "catalog:",
    "@babel/parser": "8.0.7",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chromatic": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-docgen": "8.0.4",
    "react-dom": "catalog:",
    "require-from-string": "2.0.2",
    "rimraf": "catalog:",
    "sass": "catalog:",
    "storybook": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:types:cjs && pnpm run build:bundles",
    "copy:license": "node ../../scripts/copy-license.mjs",
    "prepack": "pnpm run copy:license",
    "build:types:cjs": "node -e \"const fs=require('node:fs');fs.cpSync('dist/esm','dist/types-cjs',{recursive:true,filter:(p)=>fs.statSync(p).isDirectory()||p.endsWith('.d.ts')});fs.writeFileSync('dist/types-cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "build:bundles": "vite build",
    "build:esm": "pnpm run build:esm:js && pnpm run build:esm:types",
    "build:esm:js": "babel src --out-dir dist/esm --extensions .tsx,.ts,.js --config-file ./babel.config.esm.cjs --ignore \"src/**/*.d.ts,src/**/*.spec.js,src/**/*.spec.ts,src/**/*.spec.tsx,src/**/*.stories.js,src/**/*.stories.ts,src/**/*.stories.tsx,src/**/*.fixtures.js,src/**/*.fixtures.ts,src/docs\"",
    "build:esm:types": "tsc -p tsconfig.build.json",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_REACT --build-script-name=demo:build",
    "clean": "rimraf dist",
    "demo": "pnpm run storybook",
    "demo:build": "storybook build -c .storybook -o dist/storybook",
    "lint": "pnpm run lint:js",
    "lint:js": "eslint src/charts src/index.ts vite.config.js --ignore-pattern \"*.spec.js\" --cache",
    "storybook": "storybook dev -p 2002 --exact-port",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "verify:suite": "node testing/verify-suite.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "dist/umd/**",
    "dist/esm/**",
    "dist/types-cjs/**",
    "src/**",
    "!src/docs/**",
    "!**/*.map",
    "!**/*.spec.js",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/*.stories.js",
    "!**/*.stories.ts",
    "!**/*.stories.tsx",
    "!**/*.stories.mdx",
    "!**/*DataBuilder.js",
    "!**/*DataBuilder.ts",
    "!**/*.fixtures.js",
    "!**/*.fixtures.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/umd/bundle/react.bundled.min.cjs"
      },
      "default": "./dist/umd/bundle/react.bundled.min.cjs"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
