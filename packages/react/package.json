{
  "name": "@britecharts/react",
  "version": "3.0.0-beta.0",
  "main": "dist/umd/bundle/react.bundled.min.js",
  "module": "src/index.js",
  "types": "src/typings/index.d.ts",
  "dependencies": {
    "@britecharts/core": "workspace:^",
    "@britecharts/wrappers": "workspace:^"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@mdx-js/react": "^1.6.22",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/manager-api": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/theming": "8.6.14",
    "babel-loader": "^8.2.3",
    "chromatic": "^6.15.0",
    "copy-webpack-plugin": "^4.6.0",
    "css-loader": "^3.0.0",
    "enzyme": "3.11.0",
    "enzyme-adapter-react-16": "1.15.7",
    "eslint": "7.32.0",
    "eslint-webpack-plugin": "2.7.0",
    "html-webpack-plugin": "^4.5.2",
    "jest": "^29.3.1",
    "raw-loader": "^4.0.2",
    "react": "16.14.0",
    "react-dev-utils": "^6.1.1",
    "react-dom": "16.14.0",
    "require-from-string": "^2.0.2",
    "rimraf": "^2.6.3",
    "sass": "^1.104.0",
    "sass-loader": "^10.5.2",
    "storybook": "8.6.14",
    "style-loader": "^0.23.1",
    "uglifyjs-webpack-plugin": "^2.0.1",
    "webpack": "4.46.0",
    "webpack-bundle-analyzer": "3.3.2",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "3.7.2",
    "webpack-fix-style-only-entries": "^0.6.1",
    "webpack-merge": "4.1.4"
  },
  "peerDependencies": {
    "prop-types": ">=15",
    "react": ">=15",
    "react-dom": ">=15"
  },
  "browserslist": "> 0.25%, not dead",
  "scripts": {
    "build:bundle": "webpack --env=prodBundleConfig",
    "build:charts:cjs": "webpack --env=prodCJSChartsConfig",
    "build:charts:umd": "webpack --env=prodChartsConfig",
    "build:charts": "webpack --env=prodChartsConfig",
    "build": "webpack --env=production",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_REACT",
    "clean": "rimraf dist",
    "demo:build": "storybook build -c .storybook -o dist/storybook",
    "demo": "yarn run storybook",
    "prebuild": "yarn run clean",
    "start": "webpack-dev-server --env=test --open --hot",
    "storybook": "storybook dev -p 2002",
    "test:watch": "jest --watch --colors",
    "test": "jest --colors --coverage"
  },
  "files": [
    "dist/umd",
    "dist/cjs",
    "src",
    "!**/*.map",
    "!src/templates",
    "!src/tasks",
    "!src/scripts",
    "!src/docs",
    "!src/**/*.spec.js",
    "!src/**/*.stories.js",
    "!src/**/*.stories.mdx",
    "!src/**/*DataBuilder.js",
    "!src/**/*.fixtures.js"
  ]
}
