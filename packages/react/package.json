{
  "name": "@britecharts/react",
  "version": "3.0.0-beta.2",
  "main": "dist/umd/bundle/react.bundled.min.js",
  "module": "src/index.js",
  "types": "src/typings/index.d.ts",
  "dependencies": {
    "@britecharts/core": "workspace:^",
    "@britecharts/wrappers": "workspace:^"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.9",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/manager-api": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/theming": "8.6.14",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "babel-loader": "8.4.1",
    "chromatic": "6.24.1",
    "copy-webpack-plugin": "4.6.0",
    "css-loader": "3.0.0",
    "eslint": "7.32.0",
    "eslint-webpack-plugin": "2.7.0",
    "html-webpack-plugin": "4.5.2",
    "jest": "29.7.0",
    "raw-loader": "4.0.2",
    "react": "19.3.0",
    "react-dev-utils": "6.1.1",
    "react-dom": "19.3.0",
    "require-from-string": "2.0.2",
    "rimraf": "2.7.1",
    "sass": "1.105.0",
    "sass-loader": "10.5.2",
    "storybook": "8.6.14",
    "style-loader": "0.23.1",
    "uglifyjs-webpack-plugin": "2.2.0",
    "webpack": "4.46.0",
    "webpack-bundle-analyzer": "3.3.2",
    "webpack-cli": "3.3.12",
    "webpack-dev-server": "3.7.2",
    "webpack-fix-style-only-entries": "0.6.1",
    "webpack-merge": "4.1.4"
  },
  "peerDependencies": {
    "prop-types": ">=15",
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "scripts": {
    "build:bundle": "webpack --env=prodBundleConfig",
    "build:charts:cjs": "webpack --env=prodCJSChartsConfig",
    "build:charts:umd": "webpack --env=prodChartsConfig",
    "build:charts": "webpack --env=prodChartsConfig",
    "build": "pnpm run clean && webpack --env=production",
    "chromatic": "chromatic --project-token=$CHROMATIC_TOKEN_REACT",
    "clean": "rimraf dist",
    "demo:build": "storybook build -c .storybook -o dist/storybook",
    "demo": "pnpm run storybook",
    "lint:js": "eslint src/charts src/index.js webpack.*.js --ignore-pattern \"*.spec.js\" --cache",
    "lint": "pnpm run lint:js",
    "start": "webpack-dev-server --env=test --open --hot",
    "storybook": "storybook dev -p 2002 --exact-port",
    "test:watch": "jest --watch --colors",
    "test": "jest --colors --coverage --coverageThreshold='{\"global\":{\"statements\":93,\"branches\":85,\"functions\":93,\"lines\":94},\"./src/charts/helpers/useChart.js\":{\"statements\":95,\"branches\":90,\"functions\":95,\"lines\":95}}'",
    "verify:suite": "node testing/verify-suite.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "dist/umd/**",
    "dist/cjs/**",
    "src/**",
    "!src/docs/**",
    "!**/*.map",
    "!**/*.spec.js",
    "!**/*.stories.js",
    "!**/*.stories.mdx",
    "!**/*DataBuilder.js",
    "!**/*.fixtures.js"
  ],
  "exports": {
    ".": {
      "types": "./src/typings/index.d.ts",
      "import": "./dist/umd/bundle/react.bundled.min.js",
      "require": "./dist/umd/bundle/react.bundled.min.js",
      "default": "./dist/umd/bundle/react.bundled.min.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
