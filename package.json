{
  "name": "britecharts",
  "packageManager": "pnpm@12.6.0",
  "version": "0.0.0",
  "description": "D3.js based Modular Charting Library",
  "main": "index.js",
  "contributors": [
    {
      "name": "Marcos Iglesias",
      "email": "golodhros@gmail.com"
    },
    {
      "name": "Daler Asrorov",
      "email": "asrorids@gmail.com"
    },
    {
      "name": "Ryan Wholey",
      "email": "rjwholey@gmail.com"
    },
    {
      "name": "Sun Dai",
      "email": "sundaisf@gmail.com"
    },
    {
      "name": "Gago",
      "email": "xeroice@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/britecharts/britecharts.git"
  },
  "keywords": [
    "d3",
    "svg",
    "chart",
    "javascript",
    "es6",
    "es2015",
    "visualizations",
    "data-visualization",
    "interactive-visualizations"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "author": "Britecharts Team",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/britecharts/britecharts/issues"
  },
  "homepage": "http://britecharts.github.io/britecharts/",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "docs",
          "fix",
          "feat",
          "chore"
        ]
      ]
    }
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "eslintConfig": {
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "extends": [
      "plugin:react/recommended",
      "plugin:react/jsx-runtime",
      "plugin:testing-library/react"
    ],
    "env": {
      "es6": true,
      "browser": true,
      "amd": true
    },
    "root": true,
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "sourceType": "module",
      "requireConfigFile": false,
      "ecmaFeatures": {
        "experimentalObjectRestSpread": true
      },
      "babelOptions": {
        "parserOpts": {
          "plugins": [
            "jsx"
          ]
        }
      }
    },
    "globals": {
      "sinon": true
    },
    "rules": {
      "block-scoped-var": 1,
      "comma-style": [
        2,
        "last"
      ],
      "complexity": 1,
      "consistent-this": [
        0,
        "self"
      ],
      "default-case": 1,
      "dot-notation": 0,
      "guard-for-in": 1,
      "keyword-spacing": 1,
      "padding-line-between-statements": [
        "error",
        {
          "blankLine": "always",
          "prev": "*",
          "next": "return"
        }
      ],
      "no-alert": 2,
      "no-console": 2,
      "no-debugger": 2,
      "no-div-regex": 1,
      "no-eq-null": 1,
      "no-floating-decimal": 1,
      "no-multiple-empty-lines": [
        2,
        {
          "max": 2
        }
      ],
      "no-nested-ternary": 1,
      "no-param-reassign": 0,
      "no-self-compare": 1,
      "no-throw-literal": 1,
      "no-void": 1,
      "no-unused-vars": [
        1,
        {
          "varsIgnorePattern": "[d3Transition]"
        }
      ],
      "no-underscore-dangle": 0,
      "quotes": [
        2,
        "single"
      ],
      "one-var": [
        1,
        {
          "var": "always",
          "const": "never"
        }
      ],
      "radix": 1,
      "vars-on-top": 1,
      "wrap-iife": [
        2,
        "inside"
      ]
    },
    "overrides": [
      {
        "files": [
          "*.d.ts"
        ],
        "parser": "@typescript-eslint/parser"
      }
    ]
  },
  "prettier": {
    "endOfLine": "lf",
    "tabWidth": 4,
    "semi": true,
    "bracketSpacing": true,
    "singleQuote": true,
    "arrowParens": "always",
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "printWidth": 70,
          "useTabs": false,
          "trailingComma": "none",
          "arrowParens": "avoid",
          "proseWrap": "never"
        }
      },
      {
        "files": "*.json",
        "options": {
          "printWidth": 70,
          "useTabs": false,
          "trailingComma": "none",
          "tabWidth": 2
        }
      }
    ]
  },
  "stylelint": {
    "plugins": [
      "stylelint-scss"
    ],
    "extends": [
      "stylelint-config-sass-guidelines",
      "stylelint-config-standard-scss"
    ],
    "rules": {
      "indentation": 4,
      "scss/dollar-variable-colon-space-after": "always",
      "no-descending-specificity": null,
      "selector-class-pattern": null,
      "max-nesting-depth": 2
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "16.3.0",
    "@commitlint/config-conventional": "16.2.4",
    "@typescript-eslint/parser": "5.62.0",
    "babel-jest": "29.7.0",
    "babel-plugin-async-import": "2.1.0",
    "babel-plugin-module-resolver": "4.1.0",
    "concurrently": "4.1.2",
    "eslint": "7.32.0",
    "eslint-config-prettier": "8.4.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-prettier": "4.0.0",
    "eslint-plugin-react": "7.29.4",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-testing-library": "5.11.1",
    "husky": "7.0.4",
    "jest": "29.7.0",
    "jest-canvas-mock": "2.5.8",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "prettier": "2.5.1",
    "prettier-eslint": "13.0.0",
    "prettier-eslint-cli": "5.0.1",
    "rimraf": "2.7.1",
    "stylelint": "14.16.1",
    "stylelint-config-sass-guidelines": "9.0.1",
    "stylelint-config-standard": "29.0.0",
    "stylelint-config-standard-scss": "4.0.0",
    "ts-jest": "29.4.13",
    "typescript": "4.9.5"
  },
  "scripts": {
    "build": "pnpm run build:core && pnpm run build:wrappers && pnpm run build:react && pnpm run build:docs && pnpm run build:demos",
    "build:core": "pnpm --filter @britecharts/core run build",
    "build:demos": "pnpm run build:demos:core && pnpm --filter @britecharts/demos run build",
    "build:demos:core": "pnpm --filter @britecharts/core run demo:build",
    "build:docs": "pnpm --filter @britecharts/docs run build",
    "build:packages": "pnpm run build:core && pnpm run build:wrappers && pnpm run build:react",
    "build:react": "pnpm --filter @britecharts/react run build",
    "build:wrappers": "pnpm --filter @britecharts/wrappers run build",
    "changeset": "changeset",
    "check": "pnpm run lint:styles && pnpm run lint:js && pnpm run test:ci",
    "clean": "pnpm -r run clean && pnpm store prune && rimraf node_modules && pnpm install",
    "demos": "concurrently -k -n core,react,shell -c cyan,magenta,green \"pnpm run demos:core\" \"pnpm run demos:react\" \"pnpm run demos:shell\"",
    "demos:core": "pnpm --filter @britecharts/core run demo",
    "demos:demos": "concurrently -k -n core,react,shell -c cyan,magenta,green \"pnpm run demos:core\" \"pnpm run demos:react\" \"pnpm run demos:shell\"",
    "demos:react": "pnpm --filter @britecharts/react run demo",
    "demos:shell": "node scripts/wait-for-storybook-refs.js http://localhost:2001/iframe.html http://localhost:2002/iframe.html -- pnpm --filter @britecharts/demos run demo",
    "docs": "pnpm --filter @britecharts/docs run start",
    "docs:build": "pnpm --filter @britecharts/docs run build",
    "docs:links": "pnpm --filter @britecharts/docs run docs:links",
    "format": "prettier --loglevel warn --write \"**/*.js\"",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "eslint src/charts/ webpack.*.js --cache --fix",
    "lint:js": "pnpm -r --parallel run lint:js",
    "lint:old": "eslint --fix --max-warnings=0 --ext js,jsx ./packages/",
    "lint:styles": "pnpm --filter @britecharts/core run lint:styles",
    "posttest": "pnpm run format",
    "prepare": "husky install",
    "release": "pnpm run build:packages && node scripts/publish-packages.js",
    "start": "pnpm -r --parallel run start",
    "stylelint": "stylelint './packages/core/src/styles/**/*.scss'",
    "stylelint:fix": "stylelint './packages/core/src/styles/**/*.scss' --fix",
    "test": "pnpm -r --parallel run test",
    "test:ci": "pnpm -r --parallel run test",
    "test:integration": "pnpm --filter @britecharts/integration run test:integration",
    "test:watch": "pnpm -r --parallel run test:watch",
    "version-packages": "changeset version"
  },
  "private": true
}
