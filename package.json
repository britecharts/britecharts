{
  "name": "britecharts",
  "packageManager": "pnpm@12.6.0",
  "version": "0.0.0",
  "description": "D3.js based Modular Charting Library",
  "main": "index.js",
  "contributors": [
    {
      "name": "Marcos Iglesias",
      "email": "golodhros@gmail.com"
    },
    {
      "name": "Daler Asrorov",
      "email": "asrorids@gmail.com"
    },
    {
      "name": "Ryan Wholey",
      "email": "rjwholey@gmail.com"
    },
    {
      "name": "Sun Dai",
      "email": "sundaisf@gmail.com"
    },
    {
      "name": "Gago",
      "email": "xeroice@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/britecharts/britecharts.git"
  },
  "keywords": [
    "d3",
    "svg",
    "chart",
    "javascript",
    "es6",
    "es2015",
    "visualizations",
    "data-visualization",
    "interactive-visualizations"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "author": "Britecharts Team",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/britecharts/britecharts/issues"
  },
  "homepage": "http://britecharts.github.io/britecharts/",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "docs",
          "fix",
          "feat",
          "chore"
        ]
      ]
    }
  },
  "browserslist": "> 0.25%, not dead, not op_mini all, not and_uc > 0, not android < 4.4.5, not samsung < 31",
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/compat": "2.1.1",
    "@stylistic/stylelint-config": "5.0.0",
    "@stylistic/stylelint-plugin": "5.3.1",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "10.0.6",
    "eslint": "catalog:",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "catalog:",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "postcss": "catalog:",
    "rimraf": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-sass-guidelines": "catalog:",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.3.0",
    "typescript": "6.0.3",
    "vitest": "catalog:",
    "vitest-canvas-mock": "catalog:"
  },
  "scripts": {
    "build": "pnpm run build:core && pnpm run build:wrappers && pnpm run build:react && pnpm run build:docs && pnpm run build:demos",
    "build:core": "pnpm --filter @britecharts/core run build",
    "build:demos": "pnpm run build:demos:core && pnpm --filter @britecharts/demos run build",
    "build:demos:core": "pnpm --filter @britecharts/core run demo:build",
    "build:docs": "pnpm --filter @britecharts/docs run build",
    "build:packages": "pnpm run build:core && pnpm run build:wrappers && pnpm run build:react",
    "build:react": "pnpm --filter @britecharts/react run build",
    "build:wrappers": "pnpm --filter @britecharts/wrappers run build",
    "changeset": "changeset",
    "check": "pnpm run lint:styles && pnpm run lint:js && pnpm run type-check && pnpm run test:ci",
    "clean": "pnpm -r run clean && pnpm store prune && rimraf node_modules && pnpm install",
    "demos": "concurrently -k -n core,react,shell -c cyan,magenta,green \"pnpm run demos:core\" \"pnpm run demos:react\" \"pnpm run demos:shell\"",
    "demos:core": "pnpm --filter @britecharts/core run demo",
    "demos:demos": "concurrently -k -n core,react,shell -c cyan,magenta,green \"pnpm run demos:core\" \"pnpm run demos:react\" \"pnpm run demos:shell\"",
    "demos:react": "pnpm --filter @britecharts/react run demo",
    "demos:shell": "node scripts/wait-for-storybook-refs.js http://localhost:2001/iframe.html http://localhost:2002/iframe.html -- pnpm --filter @britecharts/demos run demo",
    "docs": "pnpm --filter @britecharts/docs run start",
    "docs:build": "pnpm --filter @britecharts/docs run build",
    "docs:source-links": "pnpm --filter @britecharts/docs run docs:source-links",
    "docs:links": "pnpm --filter @britecharts/docs run docs:links",
    "format": "sh -c 'oxfmt \"${@:-**/*.{js,ts,tsx}}\"' --",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "eslint src/charts/ webpack.*.js --cache --fix",
    "lint:js": "pnpm -r --parallel run lint:js",
    "lint:old": "eslint --fix --max-warnings=0 --ext js,jsx ./packages/",
    "lint:styles": "pnpm --filter @britecharts/core run lint:styles",
    "posttest": "pnpm run format",
    "prepare": "husky",
    "release": "pnpm run build:packages && node scripts/publish-packages.js",
    "start": "pnpm -r --parallel run start",
    "stylelint": "stylelint './packages/core/src/styles/**/*.scss'",
    "stylelint:fix": "stylelint './packages/core/src/styles/**/*.scss' --fix",
    "test": "pnpm -r --parallel run test",
    "test:ci": "pnpm -r --parallel run test",
    "test:integration": "pnpm --filter @britecharts/integration run test:integration",
    "test:watch": "pnpm -r --parallel run test:watch",
    "check:api-parity": "pnpm --filter @britecharts/core run check:api-parity",
    "type-check": "pnpm -r --parallel run type-check",
    "version-packages": "changeset version"
  },
  "private": true
}
